# Backend API configuration
APP_SECRET=dev-secret-change-me
TOKEN_TTL_HOURS=1
REFRESH_TOKEN_TTL_HOURS=168
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_HOURS=2
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15

# URL du backend (critique pour Flutter web)
BACKEND_URL=http://127.0.0.1:8000

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=575420266385-bv0qji08uclebts3eojk5uc4n54npps5.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_IDS=575420266385-bv0qji08uclebts3eojk5uc4n54npps5.apps.googleusercontent.com

# Redirection OAuth après connexion Google
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Database
DATABASE_URL=sqlite:///./backend_data/app.db

# SMTP
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=no-reply@example.com

# File upload limits
MAX_UPLOAD_BYTES=8388608

# Firebase Cloud Messaging
